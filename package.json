{
  "name": "espressly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "assets:download": "node scripts/download-images.cjs",
    "assets:check": "node scripts/check-assets.cjs",
    "assets:logo": "node scripts/build-logo-assets.cjs && node scripts/build-logo-variants.cjs",
    "verify:reveals": "node scripts/verify-reveals.cjs",
    "verify:interactions": "node scripts/verify-interactions.cjs",
    "verify:layout": "node scripts/verify-layout.cjs",
    "verify": "npm run verify:interactions && npm run verify:layout && npm run verify:reveals",
    "audit:assets": "node scripts/audit-assets.cjs",
    "shoot": "node scripts/shoot.cjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^14.0.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "puppeteer": "^25.12.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
